---
# Variables globales para el despliegue con Ansible (Plantilla de ejemplo)
# Copia este archivo a 'all.yml' e ingresa tus valores reales
proyecto: asistencia
repo_url: "https://github.com/escobarnina/Mi-asistencia.git"
repo_branch: "feat/tvms"

# Base de Datos MariaDB / MySQL
db_port: 3306
db_name: asistencia
db_user: asistencia
db_password: "CHANGE_ME_DB_PASSWORD"

# Backend API
backend_port: 8000
jwt_secret: "CHANGE_ME_JWT_SECRET_KEY"
jwt_minutos: 480
admin_email: "admin@ejemplo.com"
admin_password: "CHANGE_ME_ADMIN_PASSWORD"
tz: "America/La_Paz"
seed_data: "true"
