PORT={{ backend_port }}
NODE_ENV=production
DB_HOST={{ hostvars[groups['database'][0]]['ansible_default_ipv4']['address'] | default(hostvars[groups['database'][0]]['ansible_all_ipv4_addresses'][0] | default(groups['database'][0])) }}
DB_PORT={{ db_port }}
MYSQL_DATABASE={{ db_name }}
MYSQL_USER={{ db_user }}
MYSQL_PASSWORD={{ db_password }}
JWT_SECRET={{ jwt_secret }}
JWT_MINUTOS={{ jwt_minutos }}
ADMIN_EMAIL={{ admin_email }}
ADMIN_PASSWORD={{ admin_password }}
SEED_DATA={{ seed_data }}
TZ={{ tz }}
CORS_ORIGINS=*
