#!/bin/bash
# =====================================================================
#  Configuración automática del BACKEND (corre una sola vez al crear la VM)
#  Node 20 + MySQL 8 local + servicio systemd. SIN Docker.
#  Log: /var/log/despliegue.log
# =====================================================================
set -euxo pipefail
exec > /var/log/despliegue.log 2>&1
export DEBIAN_FRONTEND=noninteractive
export HOME=/root
APT="apt-get -y -o DPkg::Lock::Timeout=300"

# --- 1. Zona horaria y memoria swap (la t3.micro solo tiene 1 GB de RAM) ---
timedatectl set-timezone America/La_Paz
if [ ! -f /swapfile ]; then
  fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# --- 2. Paquetes: git, MySQL 8 y Node.js 20 ---
$APT update
$APT install git curl ca-certificates mysql-server
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
$APT install nodejs

# --- 3. MySQL: utf8mb4, base de datos y usuario de la app ---
cat > /etc/mysql/mysql.conf.d/zz-asistencia.cnf <<'EOF'
[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_unicode_ci
bind-address         = 127.0.0.1
EOF
systemctl restart mysql

mysql <<'EOF'
CREATE DATABASE IF NOT EXISTS asistencia CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS 'asistencia'@'localhost' IDENTIFIED BY '${db_password}';
CREATE USER IF NOT EXISTS 'asistencia'@'127.0.0.1' IDENTIFIED BY '${db_password}';
GRANT ALL PRIVILEGES ON asistencia.* TO 'asistencia'@'localhost';
GRANT ALL PRIVILEGES ON asistencia.* TO 'asistencia'@'127.0.0.1';
FLUSH PRIVILEGES;
EOF

# --- 4. Usuario de sistema y código fuente ---
id asistencia || useradd --system --create-home --shell /bin/bash asistencia
rm -rf /opt/asistencia
git clone --branch ${repo_rama} --depth 1 ${repo_url} /opt/asistencia

# .env en la RAÍZ del repo (el backend lo busca ahí con dotenv)
cat > /opt/asistencia/.env <<'EOF'
NODE_ENV=production
PORT=8000
DB_HOST=127.0.0.1
DB_PORT=3306
MYSQL_DATABASE=asistencia
MYSQL_USER=asistencia
MYSQL_PASSWORD=${db_password}
JWT_SECRET=${jwt_secret}
JWT_MINUTOS=480
ADMIN_EMAIL=${admin_email}
ADMIN_PASSWORD='${admin_password}'
TZ=America/La_Paz
# nginx del frontend reenvía /api (mismo origen), así que CORS casi no se usa
CORS_ORIGINS=http://localhost:5173
EOF
chmod 600 /opt/asistencia/.env
chown -R asistencia:asistencia /opt/asistencia

# --- 5. Dependencias + migraciones (+ semilla) ---
sudo -u asistencia -H bash -c 'cd /opt/asistencia/backend && npm ci && NODE_ENV=production npm run migrate'
%{ if cargar_semilla ~}
sudo -u asistencia -H bash -c 'cd /opt/asistencia/backend && NODE_ENV=production npm run seed'
%{ endif ~}

# --- 6. Servicio systemd: arranca solo y se reinicia si se cae ---
cat > /etc/systemd/system/asistencia-backend.service <<'EOF'
[Unit]
Description=Sistema de Asistencia - Backend (Node/Express)
After=network.target mysql.service
Requires=mysql.service

[Service]
User=asistencia
WorkingDirectory=/opt/asistencia/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now asistencia-backend

# --- 7. Script para actualizar desde GitHub: sudo actualizar-backend ---
cat > /usr/local/bin/actualizar-backend <<'EOF'
#!/bin/bash
set -e
sudo -u asistencia -H bash -c 'cd /opt/asistencia && git pull && cd backend && npm ci && NODE_ENV=production npm run migrate'
systemctl restart asistencia-backend
sleep 2 && curl -s http://127.0.0.1:8000/api/health && echo
EOF
chmod +x /usr/local/bin/actualizar-backend

sleep 3
curl -s http://127.0.0.1:8000/api/health
echo "=== BACKEND LISTO ==="
