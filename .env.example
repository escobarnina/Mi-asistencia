# ============================================================
#  Variables de ejemplo. Copia este archivo a .env y ajústalo.
#    cp .env.example .env
#  El archivo .env real NO se sube al repositorio.
# ============================================================

# --- Base de datos MySQL 8 ---
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=asistencia
MYSQL_USER=asistencia
MYSQL_PASSWORD=cambia_esta_clave

# Host y puerto de la base de datos.
#   - Dentro de docker-compose el host es "db".
#   - Para correr pruebas/semilla desde tu máquina usa "localhost".
DB_HOST=db
DB_PORT=3306

# Cadena de conexión equivalente (referencia; el backend usa las variables de arriba)
DATABASE_URL=mysql://asistencia:cambia_esta_clave@db:3306/asistencia

# --- Seguridad / JWT ---
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_MINUTOS=480

# --- Administrador inicial (lo crea la semilla: npm run seed) ---
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=Admin1234

# --- Zona horaria de toda la app ---
TZ=America/La_Paz

# --- CORS: orígenes permitidos (separados por coma si hay varios) ---
CORS_ORIGINS=http://localhost:5173
